<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin | Assados com Carinho</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <main class="auth-card">
    <header>
      <h1>Area administrativa</h1>
      <p>Entre para gerenciar pratos e cardapio do dia.</p>
    </header>

    <form action="/admin/login" method="post">
      <%- include('../partials/flash') %>
      <label for="user">
        Usuario
        <input type="text" id="user" name="user" autocomplete="username" required>
      </label>
      <label for="password">
        Senha
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="btn" type="submit">Entrar</button>
    </form>

    <div class="auth-footer">
      <% if (!hasAdmin) { %>
        <a class="btn-secondary" href="/admin/setup">Criar primeiro administrador</a>
      <% } %>
      <a class="btn-secondary" href="/">Voltar ao cardapio</a>
    </div>
  </main>
</body>
</html>
