<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Criar Admin | Assados com Carinho</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <main class="auth-card">
    <header>
      <h1>Primeiro administrador</h1>
      <p>Crie o usuario que tera acesso ao painel.</p>
    </header>

    <form action="/admin/setup" method="post">
      <%- include('../partials/flash') %>
      <label for="user">
        Usuario
        <input type="text" id="user" name="user" autocomplete="username" required>
      </label>
      <label for="password">
        Senha
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="6" required>
      </label>
      <button class="btn" type="submit">Criar administrador</button>
    </form>
  </main>
</body>
</html>
